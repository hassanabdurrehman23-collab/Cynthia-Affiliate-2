  .kpi-sub { font-size: 12px; color: var(--muted); margin-top: 6px; }
  .kpi-sub.success { color: var(--success); font-weight: 600; }

  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
  }

  .card-head {
    display: flex; align-items: center; justify-content: space-between;
