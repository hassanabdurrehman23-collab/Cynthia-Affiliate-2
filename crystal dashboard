  .lb-row:last-child { border-bottom: none; }
  .lb-rank {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    display: grid; place-items: center;
    font-weight: 700; font-size: 12px;
    flex-shrink: 0;
