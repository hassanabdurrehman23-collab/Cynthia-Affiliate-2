  }
  function fmtDate(dateStr) {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  // Toast
  const toast = document.getElementById('toast');
  function showToast(msg) {
    toast.textContent = msg;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 1600);
  }

  // ---- Render leaderboard (top 5 by leads) ----
  const lb = [...SUBS].sort((a, b) => b.leads - a.leads).slice(0, 5);
  const rankClass = ['gold', 'silver', 'bronze', '', ''];
  document.getElementById('leaderboard').innerHTML = lb.map((s, i) => `
    <div class="lb-row">
      <div class="lb-rank ${rankClass[i] || ''}">${i + 1}</div>
      <div class="lb-meta">
        <div class="lb-name">${s.name}${s.isCompany ? ' <span style="color:var(--muted);font-weight:400;">(company)</span>' : ''}</div>
        <div class="lb-sub">Joined ${fmtDate(s.joined)}</div>
      </div>
      <div class="lb-stat">${s.leads} ${s.leads === 1 ? 'lead' : 'leads'}</div>
    </div>
  `).join('');

  // ---- Render table ----
  let sortKey = 'leads', sortDir = -1;
  function renderTable() {
    const sorted = [...SUBS].sort((a, b) => {
      let av, bv;
      switch (sortKey) {
        case 'name': av = a.name; bv = b.name; break;
        case 'join': av = a.joined; bv = b.joined; break;
        case 'days': av = daysSince(a.joined); bv = daysSince(b.joined); break;
        case 'leads': av = a.leads; bv = b.leads; break;
        case 'customers': av = a.customers; bv = b.customers; break;
        case 'revenue': av = a.revenue; bv = b.revenue; break;
        case 'status': av = statusOf(a); bv = statusOf(b); break;
      }
      if (av < bv) return -sortDir;
      if (av > bv) return sortDir;
      return 0;
    });
    document.getElementById('affRows').innerHTML = sorted.map(s => `
      <tr>
        <td>
          <div class="person">
            <div class="pavatar">${initials(s.name)}</div>
            <div class="person-meta">
              <span class="person-name">${s.name}${s.isCompany ? ' <span style="color:var(--muted);font-weight:400;font-size:11px;">company</span>' : ''}</span>
              <span class="person-email">${s.email}</span>
            </div>
          </div>
        </td>
        <td>${fmtDate(s.joined)}</td>
        <td class="num">${daysSince(s.joined)} d</td>
        <td class="num">${s.leads}</td>
        <td class="num">${s.customers}</td>
        <td class="num">$${s.revenue.toFixed(2)}</td>
        <td>${statusTag(s)}</td>
        <td><button class="icon-btn" data-link="${s.link}">Copy link</button></td>
      </tr>
    `).join('');
  }
  renderTable();

  // Header sort
  document.querySelectorAll('th[data-sort]').forEach(th => {
    th.addEventListener('click', () => {
      const k = th.dataset.sort;
      if (k === sortKey) sortDir = -sortDir;
      else { sortKey = k; sortDir = -1; }
      renderTable();
    });
  });

  // Copy link
  document.addEventListener('click', async (e) => {
    if (e.target.matches('[data-link]')) {
      try {
        await navigator.clipboard.writeText(e.target.dataset.link);
        showToast('Sub-affiliate link copied');
      } catch {
        showToast('Press ⌘+C to copy');
      }
    }
  });

  // ---- Render referral leads table ----
  const leadStatusTag = (l) => l.tag === 'referral client'
    ? '<span class="tag active">Converted ✓</span>'
    : '<span class="tag new">In pipeline</span>';

  document.getElementById('leadRows').innerHTML = LEADS
    .sort((a, b) => new Date(b.submitted) - new Date(a.submitted))
    .map(l => `
      <tr>
        <td>
          <div class="person">
            <div class="pavatar">${initials(l.name)}</div>
            <div class="person-meta">
              <span class="person-name">${l.name}</span>
              <span class="person-email">${l.email}</span>
            </div>
          </div>
        </td>
        <td>${l.phone}</td>
        <td>${fmtDate(l.submitted)}</td>
        <td class="num">${daysSince(l.submitted)} d</td>
        <td>${l.lastActivity ? fmtDate(l.lastActivity) : '<span style="color:var(--muted)">—</span>'}</td>
        <td>${leadStatusTag(l)}</td>
        <td><span style="color:var(--muted); font-style:italic;">unattributed</span></td>
      </tr>
    `).join('');

  // ---- Growth chart ----
  // Cumulative signups by date
  const dates = ['Apr 22', 'Apr 23', 'Apr 28', 'Apr 29', 'May 5'];
  const counts = [9, 13, 14, 15, 17];
  const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
  const ctx = document.getElementById('growthChart').getContext('2d');
  const grad = ctx.createLinearGradient(0, 0, 0, 260);
  grad.addColorStop(0, 'rgba(79,70,229,.30)');
  grad.addColorStop(1, 'rgba(79,70,229,0)');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: dates,
      datasets: [{
        label: 'Sub-affiliates',
        data: counts,
        borderColor: accent,
        backgroundColor: grad,
        fill: true,
        tension: 0.3,
        borderWidth: 2,
        pointRadius: 5,
        pointBackgroundColor: accent,
        pointHoverRadius: 7,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => `${c.parsed.y} total recruits` } } },
      scales: {
        y: { beginAtZero: true, grid: { color: '#eef0f4' }, ticks: { stepSize: 5 } },
        x: { grid: { display: false } }
      }
    }
  });
</script>
</body>
</html>
